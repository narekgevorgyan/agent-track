{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-track",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // No database_id: wrangler auto-creates the database on first `wrangler deploy`
  // and writes the id back into this file.
  "d1_databases": [
    { "binding": "DB", "database_name": "agent-track-db", "migrations_dir": "migrations" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp"]
  },
  // Set with: openssl rand -hex 32 | npx wrangler secret put API_TOKEN
  "secrets": { "required": ["API_TOKEN"] },
  "vars": { "APP_VERSION": "0.1.0" }
}
